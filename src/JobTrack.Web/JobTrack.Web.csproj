<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <PackageId>JobTrack.Web</PackageId>
        <Description>Server-rendered ASP.NET Core Razor Pages application: browser workflows and the initial HTTP API. No direct provider or SQL access.</Description>
        <IsPackable>false</IsPackable>
        <!-- Application host, not a consumed library surface — no public API doc requirement. -->
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <!-- The host's internal display helpers (DurationDisplay and friends) are unit-testable directly
             rather than only through rendered page HTML; nothing here is a public library surface. -->
        <InternalsVisibleTo Include="JobTrack.Web.IntegrationTests"/>
    </ItemGroup>

    <!-- The login page names the build's git revision, so someone reporting a defect can say which
         build they saw it on. Setting SourceRevisionId is all that is needed: the SDK appends it to
         AssemblyInformationalVersionAttribute as "0.1.0+<revision>", which BuildRevision reads back.

         `git describe` rather than `rev-parse` so the revision reads as "tag-commitsSince-gSha" the
         moment a release tag exists; `always` keeps it to the bare sha until one does (the monorepo
         carries no tags today), and `dirty` marks a binary built from a modified tree, which is
         exactly the build most worth not mistaking for its nearest commit.

         `git -C` resolves the monorepo root from the project directory rather than the working
         directory the build was invoked from. ContinueOnError keeps a source drop with no .git (or
         no git binary) building — BuildRevision then reports null and the header omits it. -->
    <Target Name="SetSourceRevisionId" BeforeTargets="GetAssemblyVersion" Condition="'$(SourceRevisionId)' == ''">
        <Exec Command="git -C &quot;$(MSBuildProjectDirectory)&quot; describe --tags --always --dirty --abbrev=12"
              ConsoleToMSBuild="true" StandardOutputImportance="low" ContinueOnError="true">
            <Output TaskParameter="ConsoleOutput" PropertyName="HeadRevision"/>
            <Output TaskParameter="ExitCode" PropertyName="HeadRevisionExitCode"/>
        </Exec>
        <PropertyGroup Condition="'$(HeadRevisionExitCode)' == '0'">
            <SourceRevisionId>$(HeadRevision.Trim())</SourceRevisionId>
        </PropertyGroup>
    </Target>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi"/>
        <!-- ADR 0037: offline QR image rendering for the two-factor enrolment page. -->
        <PackageReference Include="QRCoder"/>
        <ProjectReference Include="..\JobTrack.Application\JobTrack.Application.csproj"/>
        <ProjectReference Include="..\JobTrack.Identity\JobTrack.Identity.csproj"/>
        <ProjectReference Include="..\JobTrack.Persistence.PostgreSql\JobTrack.Persistence.PostgreSql.csproj"/>
        <ProjectReference Include="..\JobTrack.Persistence.Sqlite\JobTrack.Persistence.Sqlite.csproj"/>
    </ItemGroup>

</Project>
