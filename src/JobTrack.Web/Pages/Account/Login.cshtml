@page
@model LoginModel
@{
	ViewData["Title"] = "Sign in";
}

<div class="jt-auth">
	<partial name="_AuthEmblem"/>
	<h1>Sign in</h1>
	<p class="jt-lede">Access your jobs, schedule, and cost reports.</p>

	<partial name="_ErrorAlert" model="Model.ErrorMessage"/>

	<form method="post" class="jt-form-card">
		<div class="form-group">
			<label asp-for="Input.UserName"></label>
			<input asp-for="Input.UserName" class="form-control" autocomplete="username"/>
			<span asp-validation-for="Input.UserName" class="text-danger"></span>
		</div>
		<div class="form-group">
			<label asp-for="Input.Password"></label>
			<input asp-for="Input.Password" type="password" class="form-control" autocomplete="current-password"/>
			<span asp-validation-for="Input.Password" class="text-danger"></span>
		</div>
		<button type="submit" class="btn btn-primary w-100">Sign in</button>
	</form>
</div>
