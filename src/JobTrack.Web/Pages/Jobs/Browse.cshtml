@page
@using System.Globalization
@using JobTrack.Abstractions
@using NodaTime
@model BrowseModel
@{
	ViewData["Title"] = "Browse job";

	// Sprite symbol id and the spoken noun for a node's kind — the two halves of the tree row's
	// leading glyph: the drawn icon (aria-hidden) and the screen-reader label that replaces it.
	static string KindIconId(NodeKind kind) => kind switch {
		NodeKind.Root => "jt-icon-root",
		NodeKind.Branch => "jt-icon-branch",
		NodeKind.Leaf => "jt-icon-leaf",
		_ => throw new ArgumentOutOfRangeException(nameof(kind), kind, null),
	};

	static string KindNoun(NodeKind kind) => kind switch {
		NodeKind.Root => "root",
		NodeKind.Branch => "branch",
		NodeKind.Leaf => "leaf",
		_ => throw new ArgumentOutOfRangeException(nameof(kind), kind, null),
	};
}

<div class="jt-page-head">
	<h1>Browse job</h1>
</div>

<partial name="_ErrorAlert" model="Model.ErrorMessage"/>

@if (Model.ErrorMessage is not null && Model.NodeId is long missingNodeId) {
	<div hidden data-jt-missing-node-id="@missingNodeId"></div>
}

<partial name="_SuccessAlert" model="Model.SuccessMessage"/>

@if (!Model.IsSearch && !Model.ShowSearchEntry) {
	<div class="jt-browse-toolbar d-flex flex-wrap align-items-center gap-2">
		@if (Model.CurrentNode is not null) {
			<nav aria-label="breadcrumb">
				<ol>
					@foreach (var ancestor in Model.CurrentNode.Ancestors) {
						<li>
							@if (ancestor.Kind == NodeKind.Root) {
								<a asp-page="/Jobs/Browse">@JobNodeDisplay.Title(ancestor, JobNodeDisplay.BreadcrumbMaxDescriptionLength)</a>
							} else {
								<a class="jt-preserve-whitespace" asp-page="/Jobs/Browse"
								   asp-route-nodeId="@ancestor.Id.Value">@JobNodeDisplay.Title(ancestor, JobNodeDisplay.BreadcrumbMaxDescriptionLength)</a>
							}
						</li>
					}
					<li class="jt-preserve-whitespace">@JobNodeDisplay.Title(Model.CurrentNode.Node, JobNodeDisplay.BreadcrumbMaxDescriptionLength)</li>
				</ol>
			</nav>
		}
		@* Search spans the whole tree, not the currently browsed subtree (IJobQueries.SearchJobNodesAsync
		   carries no root scoping), so it is a standalone entry point rather than a filter bolted onto
		   whatever node happens to be on screen. Hidden once already on the search view -- it would
		   only point back at itself; the _BrowseFilter form's own "Browse" button is the way back from
		   there. *@
		<a class="btn btn-secondary ms-auto" asp-page="/Jobs/Browse" asp-route-search="true">Search</a>
	</div>
}

@if (Model.IsSearch) {
	<h2>Search results for "@Model.SearchText"</h2>
	<partial name="_BrowseFilter" model="Model"/>
} else if (Model.ShowSearchEntry) {
	<h2>Search</h2>
	<partial name="_BrowseFilter" model="Model"/>
} else if (Model.CurrentNode is not null) {
	<h2 class="jt-preserve-whitespace">@JobNodeDisplay.Title(Model.CurrentNode.Node)</h2>

	WorkRowActionsModel? toolbarActions = null;
	if (!Model.CurrentNode.Node.HasChildren && Model.CurrentNode.Node.Kind != NodeKind.Root) {
		toolbarActions = Model.WorkRowActionsFor(
			Model.CurrentNode.Node.Id, "Start", "leafNodeId", Model.CurrentNodeAchievement, Model.CurrentNode.Node.ArchivedAt is not null, true);
	}

	var showActive = toolbarActions is not null
	                 && (toolbarActions.ActiveSessions.Count > 0 || toolbarActions.IsStartClosed || toolbarActions.IsPaused);

	@* Two field columns on wide screens, one on phones (Bootstrap's row-cols utility); write-up alone
	   spans both via col-12 below. jt-record--full lifts the shared dl's 44rem cap and drops its
	   row-gap so Bootstrap's g-2 gutter owns the vertical rhythm alone -- the two stacked gaps were
	   the excess space. Each field is its own <div class="col"> holding one dt/dd pair directly (no
	   further nested <div>), which is both what HTML5's <dl> content model permits and what axe's
	   definition-list rule requires -- the label/value split within that one div is plain flex + width
	   utilities rather than a nested Bootstrap row/col, so the grid can reflow the variable
	   (conditional) set of fields below. *@
	<dl class="row row-cols-1 row-cols-md-2 g-2 jt-record--full">
		<div class="col row g-1">
			<dt class="col-12 col-sm-4">Kind</dt>
			<dd class="col-12 col-sm-8 mb-0">
				<partial name="_KindIcon" model="@(new KindIconModel { Kind = Model.CurrentNode.Node.Kind })"/>
			</dd>
		</div>
		<div class="col row g-1">
			<dt class="col-12 col-sm-4">Owner</dt>
			<dd class="col-12 col-sm-8 mb-0 d-flex flex-wrap align-items-center gap-2">
				<span class="jt-tag">@Model.DescribeOwner(Model.CurrentNode.Node.OwnerUserId)</span>
				@* The claim control sits on the field it changes, not only in the toolbar — an
				   unassigned owner and the one action that resolves it read as a single fact. *@
				@if (Model.CurrentNode.Node.OwnerUserId is null) {
					<partial name="_PickUpButton"
					         model="@(new PickUpButtonModel { NodeId = Model.CurrentNode.Node.Id.Value, PageStateFields = Model.RowStateFields })"/>
				}
			</dd>
		</div>
		<div class="col row g-1">
			<dt class="col-12 col-sm-4">Priority</dt>
			<dd class="col-12 col-sm-8 mb-0">@{ var priorityDeadline = Model.CurrentNode.Node.NeededFinish ?? Model.CurrentNode.Node.NeededStart; }
				<partial
					name="_PriorityLabel"
					model="@(new PriorityLabelModel { Priority = Model.CurrentNode.Node.Priority, Full = true })"/>
				@if (priorityDeadline is Instant priorityDeadlineInstant) {
					@* The closing paren stays on the same line as the span it closes: a line break here is
					   rendered whitespace, which showed as "26 Jul 2030 )" on the page. The overdue class is
					   hoisted into a local so wrapping the attribute is never tempting again. *@
					var deadlineClass = InstantDisplay.IsPast(priorityDeadlineInstant, Model.Now) ? "jt-overdue" : null;
					<text>(deadline <span class="@deadlineClass">@InstantDisplay.FormatDate(priorityDeadlineInstant, Model.ViewerZone)</span>)</text>
				}
			</dd>
		</div>
		@if (Model.RequestContext is not null) {
			<div class="col row g-1">
				<dt class="col-12 col-sm-4">Requester</dt>
				<dd class="col-12 col-sm-8 mb-0">
					<a class="jt-tag" asp-page="/Requests/Details" asp-route-id="@Model.RequestContext.JobNodeId.Value"
					   asp-route-returnUrl="@Model.BrowseReturnUrl">@Model.RequestContext.RequesterDisplayName (@Model.RequestContext.RequesterUserName)</a>
				</dd>
			</div>
		}
		@* The card runs the job's standing facts first (Kind, Owner, Priority, Requester, Cost), then its
		   status in one block: Achievement, Readiness, Active. Achievement and Readiness are reported for
		   a branch as well as a leaf, and Active only for a leaf, so ordering the block this way keeps
		   every field a branch and a leaf share in the same grid cell on both -- Cost above all, the
		   field most worth scanning across a subtree, which moved under the reader when the leaf-only
		   Active preceded it. Active last also reads right on its own terms: it is the transient fact of
		   this moment, behind the standing ones rather than displacing them. *@
		@if (Model.Subtree?.RootTotal.HasValue == true && Model.Subtree.RootAllocatedDuration is not null) {
			<div class="col row g-1">
				<dt class="col-12 col-sm-4">Cost</dt>
				@* The concurrent-work link qualifies the cost figure rather than standing as a field of its
				   own: a total lower than the hours worked would suggest means this job shared its workers'
				   time with another, and this is where that is answered. It therefore follows cost
				   visibility (ADR 0042) -- a viewer shown no cost is offered no breakdown of it. Leaves
				   only -- sessions attach to leaf_work, so a branch has none of its own; a subtree
				   aggregation is the future branch case. The link and its single leading space stay on the
				   span's own line: a line break here renders as further whitespace beside the figure. *@
				<dd class="col-12 col-sm-8 mb-0"><span class="jt-amount">@CostDisplay.FormatField(
							Model.Subtree.RootTotal.Value, Model.Subtree.RootAllocatedDuration)</span>
					@if (Model.CurrentNode.Node.Kind == NodeKind.Leaf) {
						<text><a class="jt-value-aside" asp-page="/Jobs/ConcurrentWork"
						         asp-route-nodeId="@Model.CurrentNode.Node.Id.Value">Info</a></text>
					}
				</dd>
			</div>
		}
		@if (Model.CurrentNodeAchievement is Achievement currentAchievement) {
			<div class="col row g-1">
				<dt class="col-12 col-sm-4">Achievement</dt>
				<dd class="col-12 col-sm-8 mb-0">
					<partial name="_AchievementIcon" model="@(new AchievementIconModel { Achievement = currentAchievement })"/>
				</dd>
			</div>
		}
		@if (Model.CurrentNodeBranchAchievement is BranchAchievement branchAchievement) {
			<div class="col row g-1">
				<dt class="col-12 col-sm-4">Achievement</dt>
				<dd class="col-12 col-sm-8 mb-0">
					<partial name="_BranchAchievementIcon" model="@(new BranchAchievementIconModel { Achievement = branchAchievement })"/>
				</dd>
			</div>
		}
		@if (Model.Readiness is not null) {
			<div class="col row g-1">
				<dt class="col-12 col-sm-4">Readiness</dt>
				<dd class="col-12 col-sm-8 mb-0">
					@if (Model.Readiness.IsReady) {
						<span class="status-pill status-pill-ready" role="status"><svg class="status-pill-glyph" viewBox="0 0 16 16"
						                                                               aria-hidden="true" focusable="false"><use
									href="#jt-icon-go"></use></svg>No blocks</span>
					} else {
						<span class="status-pill status-pill-blocked" role="status"><svg class="status-pill-glyph" viewBox="0 0 16 16"
						                                                                 aria-hidden="true" focusable="false"><use
									href="#jt-icon-stop"></use></svg>Blocked</span>
					}
				</dd>
			</div>
		}
		@if (showActive) {
			<div class="col row g-1">
				<dt class="col-12 col-sm-4">Active</dt>
				<dd class="col-12 col-sm-8 mb-0">
					<partial name="_ActiveSincePill" model="@(new ActiveSessionSummaryModel {
						                                        ActiveSessions = toolbarActions!.ActiveSessions,
						                                        ViewerId = Model.CurrentActorId ?? new AppUserId(0),
						                                        DescribeWorker = id => Model.DescribeOwner(id),
						                                        ViewerZone = Model.ViewerZone,
						                                        Now = Model.Now,
						                                        Compact = false,
						                                        StartClosed = toolbarActions.IsStartClosed,
						                                        Paused = toolbarActions.IsPaused,
					                                        })"/>
				</dd>
			</div>
		}
		@if (!string.IsNullOrWhiteSpace(Model.CurrentNode.Node.WriteUp)) {
			@* Full width at every breakpoint with the label stacked above a full-width value (no
			   label/value column split): a write-up can run long, so it gets the whole card width while the
			   short fields pair up two-per-row beside it. w-100 (not col-12) because row-cols-md-2's
			   `> *` rule outranks .col-12 on equal specificity -- only the !important width wins. *@
			<div class="col w-100">
				<dt class="mb-1">Writeup</dt>
				<dd class="mb-0 jt-preserve-whitespace">@Model.CurrentNode.Node.WriteUp</dd>
			</div>
		}
		@if (Model.CurrentNode.Node.ArchivedAt is Instant archivedAt) {
			<div class="col row g-1">
				<dt class="col-12 col-sm-4">Archived</dt>
				<dd class="col-12 col-sm-8 mb-0">@InstantDisplay.Format(archivedAt, Model.ViewerZone)</dd>
			</div>
		}
	</dl>

	BackdateDisclosureModel? toolbarBackdate = null;
	<div class="jt-toolbar d-flex flex-wrap gap-2 align-items-center">
		@if (toolbarActions is not null) {
			@if (toolbarActions.ViewerSession is null && !toolbarActions.IsStartClosed) {
				<form method="post" asp-page-handler="Start" class="inline-form">
					@foreach (var field in toolbarActions.StartFields) {
						<input type="hidden" name="@field.Key" value="@field.Value"/>
					}
					<button type="submit" class="btn btn-primary">
						<svg class="jt-btn-glyph" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
							<use href="#jt-icon-start"></use>
						</svg>
						Start session
					</button>
				</form>
				toolbarBackdate = toolbarActions.StartBackdate;
				<partial name="_BackdateTrigger" model="toolbarBackdate"/>
			}

			@if (toolbarActions.CanManage && !toolbarActions.IsStartClosed) {
				<partial name="_StartForTrigger" model="toolbarActions.StartFor"/>
			}

			<a class="btn btn-secondary" asp-page="/Jobs/Work" asp-route-leafNodeId="@Model.CurrentNode.Node.Id.Value"
			   asp-route-returnUrl="@Model.BrowseReturnUrl">
				<svg class="jt-btn-glyph" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
					<use href="#jt-icon-sessions"></use>
				</svg>
				Sessions
			</a>
			<a class="btn btn-outline-danger"
			   asp-page="/Jobs/Delete"
			   asp-route-nodeId="@Model.CurrentNode.Node.Id.Value"
			   data-jt-confirm="Delete this job node permanently? You will review the details on the next page.">Delete</a>
			<span class="jt-toolbar-divider" aria-hidden="true"></span>
		}
		@* No Pick up here: the claim control lives on the Owner field above, beside the value it
		   changes. Two controls for one action on one node is a choice the reader has to resolve
		   before acting, and the record card is where the ownership fact already reads. *@
		@if (Model.RequestContext is not null) {
			<a class="btn btn-secondary" asp-page="/Requests/Details" asp-route-id="@Model.RequestContext.JobNodeId.Value"
			   asp-route-returnUrl="@Model.BrowseReturnUrl">Request</a>
		}
		<a class="btn btn-secondary" asp-page="/Jobs/Edit" asp-route-nodeId="@Model.CurrentNode.Node.Id.Value">Edit</a>
		@if (Model.CurrentNode.Node.ParentId is not null) {
			<a class="btn btn-secondary" asp-page="/Jobs/Move" asp-route-nodeId="@Model.CurrentNode.Node.Id.Value">Move</a>
		}
		@if (Model.CurrentNode.Node.Kind != NodeKind.Root) {
			<a class="btn btn-secondary" asp-page="/Jobs/Prerequisites" asp-route-nodeId="@Model.CurrentNode.Node.Id.Value">Dependencies</a>
		}
		@if (Model.CurrentNode.Node.HasChildren) {
			<a class="btn btn-secondary" asp-page="/Jobs/AwaitingProgress" asp-route-subtreeRootId="@Model.CurrentNode.Node.Id.Value">Awaiting
				progress in subtree</a>
		}
		@if (!Model.CurrentNode.Node.HasChildren && Model.CurrentNode.Node.Kind != NodeKind.Root) {
			<a class="btn btn-secondary" asp-page="/Jobs/Decompose" asp-route-leafNodeId="@Model.CurrentNode.Node.Id.Value">Decompose</a>
		}
		@if (!Model.CurrentNode.Node.HasLeafWork) {
			<a class="btn btn-secondary" asp-page="/Jobs/Create" asp-route-parentId="@Model.CurrentNode.Node.Id.Value">Create child</a>
		}
		@if (Model.CurrentNode.Node.Kind != NodeKind.Leaf) {
			var isCurrentHomeNode = Model.HomeNodeId == Model.CurrentNode.Node.Id || (Model.HomeNodeId is null && Model.CurrentNode.Node.Kind == NodeKind.Root);
			@if (isCurrentHomeNode) {
				<form method="post" asp-page-handler="ResetHomeNode" class="inline-form">
					<input type="hidden" name="NodeId" value="@Model.NodeId"/>
					<input type="hidden" name="OwnerUserId" value="@Model.OwnerUserId"/>
					<input type="hidden" name="ArchiveFilter" value="@Model.ArchiveFilter"/>
					<input type="hidden" name="SearchText" value="@Model.SearchText"/>
					<input type="hidden" name="ShowArchived" value="@Model.ShowArchived"/>
					<button type="submit" class="btn btn-secondary">Reset home node to root</button>
				</form>
			} else {
				<form method="post" asp-page-handler="SetHomeNode" class="inline-form">
					<input type="hidden" name="NodeId" value="@Model.NodeId"/>
					<input type="hidden" name="OwnerUserId" value="@Model.OwnerUserId"/>
					<input type="hidden" name="ArchiveFilter" value="@Model.ArchiveFilter"/>
					<input type="hidden" name="SearchText" value="@Model.SearchText"/>
					<input type="hidden" name="ShowArchived" value="@Model.ShowArchived"/>
					<input type="hidden" name="homeNodeId" value="@Model.CurrentNode.Node.Id.Value"/>
					<button type="submit" class="btn btn-secondary">Set as home node</button>
				</form>
			}
		}
	</div>
	@if (toolbarBackdate is not null) {
		@if (toolbarBackdate is not null) {
			<partial name="_BackdatePanel" model="toolbarBackdate"/>
		}
	}

	@if (Model.CurrentNode.Node.Kind != NodeKind.Root && (Model.Requires.Count > 0 || Model.RequiredBy.Count > 0)) {
		@* Requires and Depends-on always appear together, so they share one card (ADR 0044 browse
		   layout): a single full-width surface flush with the toolbar and subtree. The two lists sit
		   side by side on wide screens and stack on narrow ones, each under its own directional
		   heading. Hidden entirely rather than shown as an empty "None." card when the node has
		   neither edge -- most nodes never declare a prerequisite, so a permanently empty card would
		   be the common case, not the exception it's styled for. *@
		<div class="jt-card">
			<div class="row g-4">
				<div class="col-md-6 jt-prereq-col">
					<p class="jt-list-heading">&larr; Requires (must finish first)</p>
					@if (Model.Requires.Count == 0) {
						@* Same .jt-list > li box as a populated row, not the taller .jt-empty panel, so an
						   empty side of this two-column card matches the other side's row height instead
						   of standing noticeably taller. *@
						<ul class="jt-list jt-list--wide mb-0">
							<li class="jt-muted">None.</li>
						</ul>
					} else {
						<ul class="jt-list jt-list--wide mb-0">
							@foreach (var node in Model.Requires) {
								<li class="d-flex flex-wrap align-items-center gap-3">
									@if (Model.BlockingRequiredIds.Contains(node.Id)) {
										<span class="status-pill status-pill--icon status-pill-blocked" role="status"><svg class="status-pill-glyph"
										                                                                                   viewBox="0 0 16 16"
										                                                                                   aria-hidden="true"
										                                                                                   focusable="false"><use
													href="#jt-icon-stop"></use></svg><span class="visually-hidden">Blocking</span></span>
									} else {
										<span class="status-pill status-pill--icon status-pill-ready" role="status"><svg class="status-pill-glyph"
										                                                                                 viewBox="0 0 16 16"
										                                                                                 aria-hidden="true"
										                                                                                 focusable="false"><use
													href="#jt-icon-go"></use></svg><span class="visually-hidden">Satisfied</span></span>
									}
									<a class="jt-preserve-whitespace" asp-page="/Jobs/Browse"
									   asp-route-nodeId="@node.Id.Value">@JobNodeDisplay.Title(node, JobNodeDisplay.RowTitleMaxDescriptionLength)</a>
									<span class="d-flex align-items-center gap-2 ms-auto">
										<partial name="_KindIcon" model="@(new KindIconModel { Kind = node.Kind, CollapseLabelOnNarrow = true })"/>
										@if (node.ArchivedAt is not null) {
											<span class="jt-muted"> · archived</span>
										}
									</span>
								</li>
							}
						</ul>
					}
				</div>
				<div class="col-md-6 jt-prereq-col">
					@* Nudged right to sit level with where "Requires" begins after its leading arrow. *@
					<p class="jt-list-heading ps-3">Depends on this job &rarr;</p>
					@if (Model.RequiredBy.Count == 0) {
						<ul class="jt-list jt-list--wide mb-0">
							<li class="jt-muted">None.</li>
						</ul>
					} else {
						<ul class="jt-list jt-list--wide mb-0">
							@foreach (var node in Model.RequiredBy) {
								<li class="d-flex flex-wrap align-items-center gap-3">
									<a class="jt-preserve-whitespace" asp-page="/Jobs/Browse"
									   asp-route-nodeId="@node.Id.Value">@JobNodeDisplay.Title(node, JobNodeDisplay.RowTitleMaxDescriptionLength)</a>
									<span class="d-flex align-items-center gap-2 ms-auto">
										<partial name="_KindIcon" model="@(new KindIconModel { Kind = node.Kind, CollapseLabelOnNarrow = true })"/>
										@if (node.ArchivedAt is not null) {
											<span class="jt-muted"> · archived</span>
										}
									</span>
								</li>
							}
						</ul>
					}
				</div>
			</div>
		</div>
	}

	@if (Model.CurrentNode.Node.Kind != NodeKind.Root && Model.AncestorBlockers.Count > 0) {
		<details class="jt-card">
			<summary class="jt-disclosure-summary">Inherited blockers (from ancestor prerequisites)</summary>
			<ul class="jt-list jt-list--wide mb-0">
				@foreach (var blocker in Model.AncestorBlockers) {
					<li>
						<div class="row g-3 align-items-center">
							<div class="col-12 col-md-6 d-flex align-items-center gap-3">
								<span class="status-pill status-pill--icon status-pill-blocked" role="status"><svg class="status-pill-glyph"
								                                                                                   viewBox="0 0 16 16"
								                                                                                   aria-hidden="true"
								                                                                                   focusable="false"><use
											href="#jt-icon-stop"></use></svg><span class="visually-hidden">Blocking</span></span>
								<a class="jt-preserve-whitespace" asp-page="/Jobs/Browse"
								   asp-route-nodeId="@blocker.RequiredJobId">@JobNodeDisplay.Title(blocker.RequiredDescription, blocker.RequiredJobId, JobNodeDisplay.RowTitleMaxDescriptionLength)</a>
							</div>
							<div class="col-12 col-md-6 d-flex align-items-center gap-3">
								<span class="jt-muted">declared on</span>
								<a class="jt-preserve-whitespace" asp-page="/Jobs/Browse"
								   asp-route-nodeId="@blocker.DeclaredOnJobId">@JobNodeDisplay.Title(blocker.DeclaredOnDescription, blocker.DeclaredOnJobId, JobNodeDisplay.RowTitleMaxDescriptionLength)</a>
							</div>
						</div>
					</li>
				}
			</ul>
		</details>
	}
}

@if (Model.IsSearch) {
	<h2>Matches</h2>
	@if (Model.Children.Count == 0) {
		<p class="jt-empty">No jobs to show.</p>
	} else {
		<div class="jt-table-block">
			<table class="table jt-browse-children-table">
				<thead>
				<tr>
					<th scope="col" class="col-8 col-md-4 col-lg-3">Description</th>
					<th scope="col" class="col-2 col-md-1">Kind</th>
					<th scope="col" class="jt-col-secondary jt-col-owner col-lg-1 d-none d-lg-table-cell">Owner</th>
					@* col-lg-2, not the col-lg-1 every other secondary column gets: two or more simultaneous
					   workers' names (the preview list below the count pill) need more than a twelfth of the
					   row at this breakpoint or they wrap to a ladder of one-word lines. Description gives up
					   the column, staying at its "at least 3 of 12" floor rather than the 4 it held before. *@
					<th scope="col" class="jt-col-active col-md-2 col-lg-2 d-none d-md-table-cell">Active</th>
					<th scope="col" class="jt-col-cost col-md-3 col-lg-2 text-end d-none d-md-table-cell">Cost</th>
					<th scope="col" class="jt-col-secondary col-lg-1 d-none d-lg-table-cell">Archived</th>
					<th scope="col" class="col-2 text-end">Actions</th>
				</tr>
				</thead>
				<tbody>
				@foreach (var child in Model.Children) {
					var childActions = child.HasChildren
						? null
						: Model.WorkRowActionsFor(child.Id, "Start", "leafNodeId", child.Achievement, child.ArchivedAt is not null);
					<tr>
						<td class="col-8 col-md-4 col-lg-3">
							<a class="jt-preserve-whitespace" asp-page="/Jobs/Browse"
							   asp-route-nodeId="@child.Id.Value">@JobNodeDisplay.Title(child, JobNodeDisplay.RowTitleMaxDescriptionLength)</a>
							<partial name="_AchievementIcon"
							         model="@(new AchievementIconModel { Achievement = child.Achievement, ShowLabel = false })"/>
							@if (child.HasChildren) {
								<span class="jt-muted"> · has children</span>
							}
						</td>
						<td class="col-2 col-md-1">
							<partial name="_KindIcon" model="@(new KindIconModel { Kind = child.Kind, ShowLabel = false })"/>
						</td>
						<td class="jt-col-secondary jt-col-owner col-lg-1 d-none d-lg-table-cell">
							@if (child.OwnerUserId is AppUserId childOwnerUserId) {
								@Model.DescribeOwner(childOwnerUserId)
							} else {
								<span class="d-inline-flex align-items-center gap-2">
									<span>Unassigned</span>
									<partial name="_PickUpButton"
									         model="@(new PickUpButtonModel { NodeId = child.Id.Value, PageStateFields = Model.RowStateFields })"/>
								</span>
							}
						</td>
						<td class="jt-col-active col-md-2 col-lg-2 d-none d-md-table-cell">
							<partial name="_ActiveSincePill"
							         model="@(new ActiveSessionSummaryModel {
								                ActiveSessions = childActions?.ActiveSessions ?? [],
								                ViewerId = Model.CurrentActorId ?? new AppUserId(0),
								                DescribeWorker = id => Model.DescribeOwner(id),
								                ViewerZone = Model.ViewerZone,
								                Now = Model.Now,
								                StartClosed = childActions?.IsStartClosed ?? false,
								                Paused = childActions?.IsPaused ?? false,
							                })"/>
						</td>
						<td class="jt-col-cost col-md-3 col-lg-2 text-end d-none d-md-table-cell">
							@if (child.Cost is Money cost && child.AllocatedDuration is not null) {
								@CostDisplay.FormatCell(cost, child.AllocatedDuration)
							}
						</td>
						<td class="jt-col-secondary col-lg-1 d-none d-lg-table-cell">@(child.ArchivedAt is not null ? "yes" : "no")</td>
						<td class="col-2">
							@if (childActions is not null) {
								<partial name="_WorkRowActions" model="childActions"/>
							}
						</td>
					</tr>
				}
				</tbody>
			</table>
		</div>
	}
} else if (Model.Subtree is not null && Model.CurrentNode is { Node.HasChildren: true }) {
	<h2>Subtree</h2>

	@if (Model.SubtreeDescendants.Count == 0) {
		<p class="jt-empty">No jobs to show.</p>
	} else {
		<div class="jt-table-block">
			<table class="table jt-browse-children-table">
				<thead>
				<tr>
					@* No Kind or Archived column: the row's leading glyph names root/branch/leaf, and an
					   archived row is flagged in place beside its name. *@
					<th scope="col" class="col-10 col-md-5 col-lg-5 col-xxl-3">Description</th>
					@* "Pri": the cells below hold an abbreviated priority label, so the word "Priority"
					   is wider than anything in its own column and holds the column open for nothing.
					   The full name still rides along visually hidden, so it is never announced as
					   a bare fragment. *@
					@* d-none d-xxl-table-cell, not the d-lg-table-cell every other secondary column gets:
					   a node's priority is one tap away on its own page, and below xxl the twelfth it
					   occupies is worth more to Description, which takes it (col-lg-4) until xxl hands it
					   back (col-xxl-3). *@
					@* The wrap inside the second tag puts a newline and tabs into the rendered attribute
					   list — invisible on the page, but it splits what BrowseWorkSessionTests' markup
					   assertions can read, so they check the heading in two contiguous pieces. *@
					<th scope="col" class="jt-col-secondary col-xxl-1 d-none d-xxl-table-cell"><span aria-hidden="true">Pri</span><span
							class="visually-hidden">Priority</span></th>
					@* col-lg-1 at every breakpoint it appears: the cell holds "d MMM" (or "HH:mm" when the
					   deadline is today), so a twelfth is already more than its content needs and the
					   heading word itself is what actually sets the floor. Description takes the rest.
					   "Due", aria-labelled "Deadline", is the same abbreviation AwaitingProgress uses for
					   this field — "Deadline" is wider than anything in the column below it. *@
					<th scope="col" class="jt-col-secondary col-lg-1 d-none d-lg-table-cell" aria-label="Deadline">Due</th>
					@* col-lg-2, not the col-lg-1 every other secondary column gets: two or more simultaneous
					   workers' names (the preview list below the count pill) need more than a twelfth of the
					   row at this breakpoint or they wrap to a ladder of one-word lines. Description gives up
					   the column, staying at its "at least 3 of 12" floor rather than the 4 it held before. *@
					<th scope="col" class="jt-col-active col-md-2 col-lg-2 d-none d-md-table-cell">Active</th>
					<th scope="col" class="jt-col-cost col-md-3 col-lg-2 text-end d-none d-md-table-cell">Cost</th>
					@* The heading is visually hidden, not removed: the word "Position" is nearly five times
					   the width of the bar it labels, so with it visible the column can never narrow to
					   the bar's own size however small the bar gets. Assistive tech still gets the name.
					   d-none/d-xxl-table-cell: the bar itself is low-value background context (site.css),
					   so it only earns space back once the viewport is wide enough to spare it. *@
					<th scope="col" class="jt-col-span col-xxl-1 d-none d-xxl-table-cell">
						<span class="visually-hidden">Position</span>
					</th>
					<th scope="col" class="col-2 text-end">Actions</th>
				</tr>
				</thead>
				<tbody>
				@foreach (var node in Model.SubtreeDescendants) {
					var (leftPct, widthPct) = Model.SubtreeSpanPercent(node);
					var nodeActions = node.HasChildren
						? null
						: Model.WorkRowActionsFor(node.Id, "Start", "leafNodeId", node.Achievement, node.ArchivedAt is not null);
					<tr>
						<td class="jt-tree-cell col-10 col-md-5 col-lg-5 col-xxl-3" data-jt-depth="@node.Depth">
							<span class="jt-tree-guide" aria-hidden="true">
								@for (var railLevel = 1; railLevel < node.Depth; ++railLevel) {
									<span class="jt-tree-rail"></span>
								}
								<span class="jt-tree-elbow"></span>
							</span>
							<span class="jt-tree-label">
								@if (!node.IsReady) {
									@* ADR 0043 decision 2: blocked rows are marked and ready rows are not — in a
									   healthy tree a sign on every row would bury the few that matter. The same
									   stop palm the readiness pill uses, so the two never read as different facts.
									   Leads the row (beside the kind icon, ahead of the name) so it reads at a
									   glance rather than after scanning past the name first. *@
									<svg class="jt-tree-flag jt-tree-blocked jt-tree-flag--leading" viewBox="0 0 16 16" aria-hidden="true"
									     focusable="false">
										<use href="#jt-icon-stop"></use>
									</svg>
									<span class="visually-hidden">Blocked by a prerequisite.</span>
								}
								<svg class="jt-tree-icon jt-tree-icon--@KindNoun(node.Kind)" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
									<use href="#@KindIconId(node.Kind)"></use>
								</svg>
								<span class="jt-tree-text">
									<span class="visually-hidden">Level @node.Depth, @KindNoun(node.Kind).</span>
									<a class="jt-tree-name-link jt-preserve-whitespace" asp-page="/Jobs/Browse"
									   asp-route-nodeId="@node.Id.Value">@JobNodeDisplay.Truncate(node.Description, JobNodeDisplay.RowTitleMaxDescriptionLength)</a>&#x2060;
									@* Trails the name rather than leading it: unlike the blocked palm, an achievement
									   is present on most leaves in a healthy tree, so it belongs where the eye lands
									   after reading the row, not competing with the kind glyph for the leading slot.
									   The zero-width word joiner above keeps the marker attached to the title's final
									   word at every column width without adding visible spacing. *@
									<partial name="_AchievementIcon"
									         model="@(new AchievementIconModel { Achievement = node.Achievement, ShowLabel = false })"/>
									@if (node.HasUnexpandedChildren) {
										@* The name already links here; this only says the container holds more
										   than is drawn, so it is a marker, not a second link to the same page. *@
										<span class="jt-tree-more" aria-hidden="true">&hellip;</span>
										<span class="visually-hidden">More levels below.</span>
									}
									@if (node.ArchivedAt is not null) {
										@* Replaces the Archived column: archived rows are the exception, so the
										   fact belongs on the few rows that carry it, not in a column of "no". *@
										<svg class="jt-tree-flag" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
											<use href="#jt-icon-archived"></use>
										</svg>
										<span class="visually-hidden">Archived.</span>
									}
								</span>
							</span>
						</td>
						<td class="jt-col-secondary col-xxl-1 d-none d-xxl-table-cell">
							<partial name="_PriorityLabel" model="@(new PriorityLabelModel { Priority = node.Priority })"/>
						</td>
						<td class="jt-col-secondary col-lg-1 d-none d-lg-table-cell">@{ var needed = node.NeededFinish ?? node.NeededStart; }
							@if (needed is Instant neededInstant) {
								<span
									class="@(InstantDisplay.IsPast(neededInstant, Model.Now) ? "jt-overdue" : null)">@InstantDisplay.FormatCompact(neededInstant, Model.ViewerZone, Model.Now)</span>
							}
						</td>
						<td class="jt-col-active col-md-2 col-lg-2 d-none d-md-table-cell">
							<partial name="_ActiveSincePill"
							         model="@(new ActiveSessionSummaryModel {
								                ActiveSessions = nodeActions?.ActiveSessions ?? [],
								                ViewerId = Model.CurrentActorId ?? new AppUserId(0),
								                DescribeWorker = id => Model.DescribeOwner(id),
								                ViewerZone = Model.ViewerZone,
								                Now = Model.Now,
								                StartClosed = nodeActions?.IsStartClosed ?? false,
								                Paused = nodeActions?.IsPaused ?? false,
							                })"/>
						</td>
						<td class="jt-col-cost col-md-3 col-lg-2 text-end d-none d-md-table-cell">
							@if (node.Cost is Money cost && node.AllocatedDuration is not null) {
								@CostDisplay.FormatCell(cost, node.AllocatedDuration)
							}
						</td>
						<td class="jt-col-span col-xxl-1 d-none d-xxl-table-cell">
							@* Geometry as SVG presentation attributes, not a `style` attribute: the CSP is
							   `style-src 'self'` with no `'unsafe-inline'`, so an inline style is dropped
							   and the bar silently collapses to nothing. The viewBox is 100 wide, so the
							   percentages map straight onto user units. *@
							<span class="jt-tree-span-track" aria-hidden="true">
								<svg class="jt-tree-span" viewBox="0 0 100 6" preserveAspectRatio="none" focusable="false">
									<rect class="jt-tree-span-fill" y="0" height="6"
									      x="@leftPct.ToString("0.##", CultureInfo.InvariantCulture)"
									      width="@widthPct.ToString("0.##", CultureInfo.InvariantCulture)"/>
								</svg>
							</span>
						</td>
						<td class="col-2">
							@if (nodeActions is not null) {
								<partial name="_WorkRowActions" model="nodeActions"/>
							}
						</td>
					</tr>
				}
				</tbody>
			</table>
		</div>
	}

	@* The one filter that stayed on Browse rather than moving to Search: it genuinely scopes this
	   subtree, unlike the owner/text fields that scope a whole-tree query. Below the list and
	   right-aligned -- an occasional-use toggle, not something that should compete with the tree
	   for attention. *@
	<div class="d-flex justify-content-end mt-3">
		<a class="btn btn-secondary btn-sm" asp-page="/Jobs/Browse" asp-route-nodeId="@Model.NodeId"
		   asp-route-showArchived="@(!Model.ShowArchived)">@(Model.ShowArchived ? "Hide archived" : "Show archived")</a>
	</div>
} else if (Model.Panel is not null) {
	<partial name="_LeafWorkSessions" model="Model.Panel"/>
} else if (Model.CurrentNode is { Node.HasChildren: false, Node.HasLeafWork: false }) {
	@* Neither branch above applies, so this node holds nothing yet -- and rendered nothing at all,
	   leaving the page to end at the record card as though the rest had failed to load. Says instead
	   what the two ways forward are, naming exactly the toolbar buttons above that offer them: a root
	   can only take children, so it is not told to start a session it is never offered. Centred in the
	   same white panel the subtree table and the sessions list occupy, so the empty case sits where the
	   full one would rather than as an aside beside it -- a div rather than a p because the shared p
	   rule caps prose at its reading measure, which would hold the panel short of that full width.
	   Both halves act rather than describing an action to go and find: the child job is the link
	   itself, and /Jobs/Create defaults the new node's owner to the viewer, so it already means "one
	   of mine" without a route value saying so; the session is the same one-click POST the toolbar's
	   own Start button makes (same handler, same hidden state), for the viewer, so it reads as a link
	   while remaining a mutation. A root takes neither work nor a session, so it is offered only the
	   child job -- never a control the command behind it would refuse. *@
	var emptyNode = Model.CurrentNode.Node;
	var emptyStartActions = emptyNode.Kind == NodeKind.Root
		? null
		: Model.WorkRowActionsFor(emptyNode.Id, "Start", "leafNodeId", Model.CurrentNodeAchievement, emptyNode.ArchivedAt is not null, true);
	<div class="jt-card text-center">
		@* One line, no line breaks between the sentence, the inline form, and the comma that follows it:
		   the form is display:inline, so a newline on either side of it is rendered whitespace and showed
		   as "session ," on the page -- the same trap as the deadline paren in the record card above.
		   Only the noun is the control: "session" is what the button acts on, so the verb and article
		   stay prose rather than swelling the click target to most of the sentence. fw-normal cancels
		   .btn's 600 weight from the design language, which read heavier than the text around it; the
		   utility wins on !important, so this stays a class rather than a CSS override. *@
		@if (emptyStartActions is not null && !emptyStartActions.IsStartClosed) {
			<text>Start a work </text>
			<form method="post" asp-page-handler="Start" class="d-inline">@foreach (var field in emptyStartActions.StartFields) {
					<input type="hidden" name="@field.Key" value="@field.Value"/>
				}
				<button type="submit" class="btn btn-link p-0 align-baseline fw-normal">session</button>
			</form>
			<text>, or create a </text>
		} else {
			<text>Get started by creating a </text>
		}
		<a asp-page="/Jobs/Create" asp-route-parentId="@emptyNode.Id.Value">child job</a>.
	</div>
}

@if (Model.CurrentNode is not null && !Model.IsSearch) {
	@* Clear is a button, not a link: it acts on this page's own local storage and navigates nowhere.
	   job-history.js unhides it only while there is something to clear, so it is never a control with
	   no effect -- which also means it stays hidden entirely without JavaScript, where the history
	   list is empty anyway. *@
	<aside class="jt-history" id="jt-history" aria-label="Recently visited">
		<div class="d-flex align-items-baseline gap-3 mb-2">
			<p class="jt-history-label">Recently visited</p>
			<button type="button" id="jt-history-clear" class="btn btn-link btn-sm jt-history-clear"
			        aria-label="Clear recently visited" hidden>Clear
			</button>
		</div>
		<ul id="jt-history-list" class="jt-history-list"></ul>
	</aside>
	<div hidden
	     data-jt-node-id="@Model.CurrentNode.Node.Id.Value"
	     data-jt-node-description="@Model.CurrentNode.Node.Description"
	     data-jt-node-kind="@Model.CurrentNode.Node.Kind"></div>
}

@section Scripts {
	<script src="~/js/job-history.js" asp-append-version="true"></script>
}
