@page
@using JobTrack.Abstractions
@using JobTrack.Identity
@using NodaTime
@model BrowseModel
@{
	ViewData["Title"] = "Browse job";
}

<div class="jt-page-head">
	<h1>Browse job</h1>
</div>

<partial name="_ErrorAlert" model="Model.ErrorMessage"/>

<partial name="_SuccessAlert" model="Model.SuccessMessage"/>

@if (!Model.IsSearch && !Model.ShowSearchEntry) {
	<div class="jt-browse-toolbar d-flex flex-wrap align-items-center gap-2">
		@if (Model.CurrentNode is not null) {
			<nav aria-label="breadcrumb">
				<ol>
					@foreach (var ancestor in Model.CurrentNode.Ancestors) {
						@* Every breadcrumb entry names its node explicitly, the root included: a bare
						   /Jobs/Browse means "my home node" (BrowseModel.LoadAsync), so the root link
						   has to carry the root's own id or there would be no way up past a home node. *@
						<li>
							<a class="jt-preserve-whitespace" asp-page="/Jobs/Browse"
							   asp-route-nodeId="@ancestor.Id.Value">@JobNodeDisplay.Title(ancestor, JobNodeDisplay.BreadcrumbMaxDescriptionLength)</a>
						</li>
					}
					<li class="jt-preserve-whitespace">@JobNodeDisplay.Title(Model.CurrentNode.Node, JobNodeDisplay.BreadcrumbMaxDescriptionLength)</li>
				</ol>
			</nav>
		}
		@* Search spans the whole tree, not the currently browsed subtree (IJobQueries.SearchJobNodesAsync
		   carries no root scoping), so it is a standalone entry point rather than a filter bolted onto
		   whatever node happens to be on screen. Hidden once already on the search view -- it would
		   only point back at itself; the _BrowseFilter form's own "Browse" button is the way back from
		   there. *@
		<a class="btn btn-secondary ms-auto" asp-page="/Jobs/Browse" asp-route-search="true">Search</a>
	</div>
}

@if (Model.IsSearch) {
	<h2>Search results for "@Model.SearchText"</h2>
	<partial name="_BrowseFilter" model="Model"/>
} else if (Model.ShowSearchEntry) {
	<h2>Search</h2>
	<partial name="_BrowseFilter" model="Model"/>
} else if (Model.CurrentNode is not null) {
	<h2 class="jt-preserve-whitespace">@JobNodeDisplay.Title(Model.CurrentNode.Node)</h2>

	WorkRowActionsModel? toolbarActions = null;
	if (!Model.CurrentNode.Node.HasChildren && Model.CurrentNode.Node.Kind != NodeKind.Root) {
		toolbarActions = Model.WorkRowActionsFor(
			Model.CurrentNode.Node.Id, "Start", "leafNodeId", Model.CurrentNodeAchievement, Model.CurrentNode.Node.ArchivedAt is not null, true);
	}

	var showActive = toolbarActions is not null
	                 && (toolbarActions.ActiveSessions.Count > 0 || toolbarActions.IsStartClosed || toolbarActions.IsPaused);

	@* Two field columns on wide screens, one on phones (Bootstrap's row-cols utility); write-up alone
	   spans both via col-12 below. jt-record--full lifts the shared dl's 44rem cap and drops its
	   row-gap so Bootstrap's g-2 gutter owns the vertical rhythm alone -- the two stacked gaps were
	   the excess space. Each field is its own <div class="col"> holding one dt/dd pair directly (no
	   further nested <div>), which is both what HTML5's <dl> content model permits and what axe's
	   definition-list rule requires -- the label/value split within that one div is plain flex + width
	   utilities rather than a nested Bootstrap row/col, so the grid can reflow the variable
	   (conditional) set of fields below. *@
	<dl class="row row-cols-1 row-cols-md-2 g-2 jt-record--full">
		<div class="col row g-1">
			<dt class="col-12 col-sm-4">Kind</dt>
			<dd class="col-12 col-sm-8 mb-0">
				<partial name="_KindIcon" model="@(new KindIconModel {
					                                 Kind = Model.CurrentNode.Node.Kind,
				                                 })"/>
			</dd>
		</div>
		<div class="col row g-1">
			<dt class="col-12 col-sm-4">Owner</dt>
			<dd class="col-12 col-sm-8 mb-0 d-flex flex-wrap align-items-center gap-2">
				<span class="jt-tag">@Model.DescribeOwner(Model.CurrentNode.Node.OwnerUserId)</span>
				@* The claim control sits on the field it changes, not only in the toolbar — an
				   unassigned owner and the one action that resolves it read as a single fact. *@
				@if (Model.CurrentNode.Node.OwnerUserId is null) {
					<partial name="_PickUpButton"
					         model="@(new PickUpButtonModel {
						                NodeId = Model.CurrentNode.Node.Id.Value, PageStateFields = Model.RowStateFields,
					                })"/>
				}
			</dd>
		</div>
		@{ var priorityDeadline = Model.CurrentNode.Node.NeededFinish ?? Model.CurrentNode.Node.NeededStart; }
		<div class="col row g-1">
			<dt class="col-12 col-sm-4">Priority</dt>
			<dd class="col-12 col-sm-8 mb-0">
				<partial
					name="_PriorityLabel"
					model="@(new PriorityLabelModel {
						       Priority = Model.CurrentNode.Node.Priority, Full = true,
					       })"/>
			</dd>
		</div>
		@* The card's field order is fixed: Kind, Owner, Priority, Cost, Deadline, Achievement, Readiness,
		   Active -- which pairs up two-per-row on md+ as Kind/Owner, Priority/Cost, Deadline/Achievement,
		   Readiness/Active, putting Deadline directly under Priority. Achievement and Readiness are
		   reported for a branch as well as a leaf, and Active only for a leaf, so every field a branch and
		   a leaf share stays in the same grid cell on both. Requester follows Active rather than sitting
		   among the standing facts: it renders on request-raised nodes only, and anywhere earlier it would
		   shift every later field into the opposite column on those nodes alone. *@
		@if (Model.Subtree?.RootTotal.HasValue == true && Model.Subtree.RootAllocatedDuration is not null) {
			<div class="col row g-1">
				<dt class="col-12 col-sm-4">Cost</dt>
				@* The concurrent-work link qualifies the cost figure rather than standing as a field of its
				   own: a total lower than the hours worked would suggest means this job shared its workers'
				   time with another, and this is where that is answered. It therefore follows cost
				   visibility (ADR 0042) -- a viewer shown no cost is offered no breakdown of it. Leaves
				   only -- sessions attach to leaf_work, so a branch has none of its own; a subtree
				   aggregation is the future branch case. The link and its single leading space stay on the
				   span's own line: a line break here renders as further whitespace beside the figure. *@
				@* @formatter:off *@
				<dd class="col-12 col-sm-8 mb-0"><span class="jt-amount">@CostDisplay.FormatField(
							Model.Subtree.RootTotal.Value, Model.Subtree.RootAllocatedDuration)</span>@if (Model.CurrentNode.Node.Kind == NodeKind.Leaf) {<text> <a class="jt-value-aside" asp-page="/Jobs/ConcurrentWork"
						         asp-route-nodeId="@Model.CurrentNode.Node.Id.Value">Info</a></text>}</dd>
				@* @formatter:on *@
			</div>
		}
		@if (priorityDeadline is Instant priorityDeadlineInstant) {
			@* The deadline is a field of its own, not a parenthetical beside Priority: the full stamp plus
			   its time remaining is too much to read as an aside. Red once passed, but only while the job
			   is still open -- a deadline missed by a job that has since ended is history, not an alarm.
			   The class is hoisted into a local so wrapping the attribute is never tempting. *@
			var deadlineClass = InstantDisplay.IsPast(priorityDeadlineInstant, Model.Now) && Model.CurrentNodeIsOpen ? "jt-overdue" : null;
			<div class="col row g-1">
				<dt class="col-12 col-sm-4">Deadline</dt>
				<dd class="col-12 col-sm-8 mb-0"><span
						class="@deadlineClass">@InstantDisplay.FormatDeadline(priorityDeadlineInstant, Model.ViewerZone, Model.Now, Model.CurrentNodeIsOpen)</span>
				</dd>
			</div>
		}
		@if (Model.CurrentNodeAchievement is Achievement currentAchievement) {
			<div class="col row g-1">
				<dt class="col-12 col-sm-4">Achievement</dt>
				<dd class="col-12 col-sm-8 mb-0">
					<partial name="_AchievementIcon" model="@(new AchievementIconModel {
						                                        Achievement = currentAchievement,
					                                        })"/>
				</dd>
			</div>
		}
		@if (Model.CurrentNodeBranchAchievement is BranchAchievement branchAchievement) {
			<div class="col row g-1">
				<dt class="col-12 col-sm-4">Achievement</dt>
				<dd class="col-12 col-sm-8 mb-0">
					<partial name="_BranchAchievementIcon" model="@(new BranchAchievementIconModel {
						                                              Achievement = branchAchievement,
					                                              })"/>
				</dd>
			</div>
		}
		@if (Model.Readiness is not null) {
			<div class="col row g-1">
				<dt class="col-12 col-sm-4">Readiness</dt>
				<dd class="col-12 col-sm-8 mb-0">
					@if (Model.Readiness.IsReady) {
						<span class="status-pill status-pill-ready" role="status"><svg class="status-pill-glyph" viewBox="0 0 16 16"
						                                                               aria-hidden="true" focusable="false"><use
									href="#jt-icon-go"></use></svg>No blocks</span>
					} else {
						<span class="status-pill status-pill-blocked" role="status"><svg class="status-pill-glyph" viewBox="0 0 16 16"
						                                                                 aria-hidden="true" focusable="false"><use
									href="#jt-icon-stop"></use></svg>Blocked</span>
					}
				</dd>
			</div>
		}
		@if (showActive) {
			<div class="col row g-1">
				<dt class="col-12 col-sm-4">Active</dt>
				<dd class="col-12 col-sm-8 mb-0">
					<partial name="_ActiveSincePill" model="@(new ActiveSessionSummaryModel {
						                                        ActiveSessions = toolbarActions!.ActiveSessions,
						                                        ViewerId = Model.CurrentActorId ?? new AppUserId(0),
						                                        DescribeWorker = id => Model.DescribeOwner(id),
						                                        ViewerZone = Model.ViewerZone,
						                                        Now = Model.Now,
						                                        Compact = false,
						                                        Archived = Model.CurrentNode.Node.ArchivedAt is not null,
						                                        Achievement = Model.CurrentNodeAchievement,
						                                        Paused = toolbarActions.IsPaused,
					                                        })"/>
				</dd>
			</div>
		}
		@if (Model.RequestContext is not null) {
			<div class="col row g-1">
				<dt class="col-12 col-sm-4">Requester</dt>
				<dd class="col-12 col-sm-8 mb-0">
					<a class="jt-tag" asp-page="/Requests/Details" asp-route-id="@Model.RequestContext.JobNodeId.Value"
					   asp-route-returnUrl="@Model.BrowseReturnUrl">@Model.RequestContext.RequesterDisplayName (@Model.RequestContext.RequesterUserName)</a>
				</dd>
			</div>
		}
		@if (!string.IsNullOrWhiteSpace(Model.CurrentNode.Node.WriteUp)) {
			@* Full width at every breakpoint with the label stacked above a full-width value (no
			   label/value column split): a write-up can run long, so it gets the whole card width while the
			   short fields pair up two-per-row beside it. w-100 (not col-12) because row-cols-md-2's
			   `> *` rule outranks .col-12 on equal specificity -- only the !important width wins. *@
			<div class="col w-100">
				<dt class="mb-1">Writeup</dt>
				<dd class="mb-0 jt-preserve-whitespace">@Model.CurrentNode.Node.WriteUp</dd>
			</div>
		}
		@if (Model.CurrentNode.Node.ArchivedAt is Instant archivedAt) {
			<div class="col row g-1">
				<dt class="col-12 col-sm-4">Archived</dt>
				<dd class="col-12 col-sm-8 mb-0">@InstantDisplay.Format(archivedAt, Model.ViewerZone)</dd>
			</div>
		}
	</dl>

	BackdateDisclosureModel? toolbarBackdate = null;
	<div class="jt-toolbar d-flex flex-wrap gap-2 align-items-center">
		@if (toolbarActions is not null) {
			@if (toolbarActions.ViewerSession is null && !toolbarActions.IsStartClosed) {
				<form method="post" asp-page-handler="Start" class="inline-form">
					@foreach (var field in toolbarActions.StartFields) {
						<input type="hidden" name="@field.Key" value="@field.Value"/>
					}
					<button type="submit" class="btn btn-primary">
						<svg class="jt-btn-glyph" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
							<use href="#jt-icon-start"></use>
						</svg>
						Start session
					</button>
				</form>
				toolbarBackdate = toolbarActions.StartBackdate;
				<partial name="_BackdateTrigger" model="toolbarBackdate"/>
			}

			@if (toolbarActions.CanManage && !toolbarActions.IsStartClosed) {
				<partial name="_StartForTrigger" model="toolbarActions.StartFor"/>
			}

			<a class="btn btn-secondary" asp-page="/Jobs/Work" asp-route-leafNodeId="@Model.CurrentNode.Node.Id.Value"
			   asp-route-returnUrl="@Model.BrowseReturnUrl">
				<svg class="jt-btn-glyph" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
					<use href="#jt-icon-sessions"></use>
				</svg>
				Sessions
			</a>
			@if (toolbarActions.CanComplete) {
				<form method="post" asp-page-handler="@toolbarActions.CompleteHandler" class="inline-form">
					@foreach (var field in toolbarActions.StartFields) {
						<input type="hidden" name="@field.Key" value="@field.Value"/>
					}
					<button type="submit" class="btn btn-primary"
					        data-jt-confirm="Complete this job? Every open session on it will be closed.">
						Complete
					</button>
				</form>
			}

			<a class="btn btn-outline-danger"
			   asp-page="/Jobs/Delete"
			   asp-route-nodeId="@Model.CurrentNode.Node.Id.Value"
			   data-jt-confirm="Delete this job node permanently? You will review the details on the next page.">Delete</a>
			<span class="jt-toolbar-divider" aria-hidden="true"></span>
		}
		@* No Pick up here: the claim control lives on the Owner field above, beside the value it
		   changes. Two controls for one action on one node is a choice the reader has to resolve
		   before acting, and the record card is where the ownership fact already reads. *@
		@if (Model.RequestContext is not null) {
			<a class="btn btn-secondary" asp-page="/Requests/Details" asp-route-id="@Model.RequestContext.JobNodeId.Value"
			   asp-route-returnUrl="@Model.BrowseReturnUrl">Request</a>
		}
		<a class="btn btn-secondary" asp-page="/Jobs/Edit" asp-route-nodeId="@Model.CurrentNode.Node.Id.Value">Edit</a>
		@if (Model.CurrentNode.Node.ParentId is not null) {
			<a class="btn btn-secondary" asp-page="/Jobs/Move" asp-route-nodeId="@Model.CurrentNode.Node.Id.Value">Move</a>
		}
		@if (Model.CurrentNode.Node.Kind != NodeKind.Root) {
			<a class="btn btn-secondary" asp-page="/Jobs/Prerequisites" asp-route-nodeId="@Model.CurrentNode.Node.Id.Value">Dependencies</a>
		}
		@if (Model.CurrentNode.Node.HasChildren) {
			<a class="btn btn-secondary" asp-page="/Jobs/AwaitingProgress" asp-route-subtreeRootId="@Model.CurrentNode.Node.Id.Value">Awaiting
				progress in subtree</a>
		}
		@* ADR 0061: recursive deletion is Administrator-only and separate from the leaf toolbar's
		   single-node Delete, so the button label states the scope before it is clicked. The page and
		   the command both re-check the role; this only decides whether to offer it. *@
		@if (Model.CurrentNode.Node.HasChildren && Model.CurrentNode.Node.Kind != NodeKind.Root
		                                        && User.IsInRole(EmployeeRoleNames.Administrator)) {
			<a class="btn btn-outline-danger"
			   asp-page="/Jobs/DeleteSubtree"
			   asp-route-nodeId="@Model.CurrentNode.Node.Id.Value">Delete subtree</a>
		}
		@if (!Model.CurrentNode.Node.HasChildren && Model.CurrentNode.Node.Kind != NodeKind.Root) {
			<a class="btn btn-secondary" asp-page="/Jobs/Decompose" asp-route-leafNodeId="@Model.CurrentNode.Node.Id.Value">Decompose</a>
		}
		@if (!Model.CurrentNode.Node.HasLeafWork) {
			<a class="btn btn-secondary" asp-page="/Jobs/Create" asp-route-parentId="@Model.CurrentNode.Node.Id.Value">Create child</a>
		}
		@* A branch or the root offers the home-node control only while it is *not* already home: on the
		   home node itself "Set as home node" would do nothing, and "Reset home node to root" answered a
		   question nobody asks while standing on the node they chose. Nothing becomes unreachable --
		   root's own "Set as home node" is how a home node moves back to the top. *@
		@if (Model.CurrentNode.Node.Kind != NodeKind.Leaf) {
			var isCurrentHomeNode = Model.HomeNodeId == Model.CurrentNode.Node.Id || Model.HomeNodeId is null && Model.CurrentNode.Node.Kind == NodeKind.Root;
			@if (!isCurrentHomeNode) {
				<form method="post" asp-page-handler="SetHomeNode" class="inline-form">
					<input type="hidden" name="NodeId" value="@Model.NodeId"/>
					<input type="hidden" name="OwnerUserId" value="@Model.OwnerUserId"/>
					<input type="hidden" name="ArchiveFilter" value="@Model.ArchiveFilter"/>
					<input type="hidden" name="SearchText" value="@Model.SearchText"/>
					<input type="hidden" name="ShowArchived" value="@Model.ShowArchived"/>
					<input type="hidden" name="homeNodeId" value="@Model.CurrentNode.Node.Id.Value"/>
					<button type="submit" class="btn btn-secondary">Set as home node</button>
				</form>
			}
		}
	</div>
	@if (toolbarBackdate is not null) {
		@if (toolbarBackdate is not null) {
			<partial name="_BackdatePanel" model="toolbarBackdate"/>
		}
	}

	@if (Model.CurrentNode.Node.Kind != NodeKind.Root && (Model.Requires.Count > 0 || Model.RequiredBy.Count > 0)) {
		@* Requires and Depends-on always appear together, so they share one card (ADR 0044 browse
		   layout): a single full-width surface flush with the toolbar and subtree. The two lists sit
		   side by side on wide screens and stack on narrow ones, each under its own directional
		   heading. Hidden entirely rather than shown as an empty "None." card when the node has
		   neither edge -- most nodes never declare a prerequisite, so a permanently empty card would
		   be the common case, not the exception it's styled for. *@
		<div class="jt-card">
			<div class="row g-4">
				<div class="col-md-6 jt-prereq-col">
					<p class="jt-list-heading">&larr; Requires (must finish first)</p>
					@if (Model.Requires.Count == 0) {
						@* Same .jt-list > li box as a populated row, not the taller .jt-empty panel, so an
						   empty side of this two-column card matches the other side's row height instead
						   of standing noticeably taller. *@
						<ul class="jt-list jt-list--wide mb-0">
							<li class="jt-muted">None.</li>
						</ul>
					} else {
						<ul class="jt-list jt-list--wide mb-0">
							@foreach (var node in Model.Requires) {
								<li class="d-flex flex-wrap align-items-center gap-3">
									@if (Model.BlockingRequiredIds.Contains(node.Id)) {
										<span class="status-pill status-pill--icon status-pill-blocked" role="status"><svg class="status-pill-glyph"
										                                                                                   viewBox="0 0 16 16"
										                                                                                   aria-hidden="true"
										                                                                                   focusable="false"><use
													href="#jt-icon-stop"></use></svg><span class="visually-hidden">Blocking</span></span>
									} else {
										<span class="status-pill status-pill--icon status-pill-ready" role="status"><svg class="status-pill-glyph"
										                                                                                 viewBox="0 0 16 16"
										                                                                                 aria-hidden="true"
										                                                                                 focusable="false"><use
													href="#jt-icon-go"></use></svg><span class="visually-hidden">Satisfied</span></span>
									}
									<a class="jt-preserve-whitespace" asp-page="/Jobs/Browse"
									   asp-route-nodeId="@node.Id.Value">@JobNodeDisplay.Title(node, JobNodeDisplay.RowTitleMaxDescriptionLength)</a>
									<span class="d-flex align-items-center gap-2 ms-auto">
										<partial name="_KindIcon" model="@(new KindIconModel {
											                                 Kind = node.Kind, CollapseLabelOnNarrow = true,
										                                 })"/>
										@if (node.ArchivedAt is not null) {
											<span class="jt-muted"> · archived</span>
										}
									</span>
								</li>
							}
						</ul>
					}
				</div>
				<div class="col-md-6 jt-prereq-col">
					@* Nudged right to sit level with where "Requires" begins after its leading arrow. *@
					<p class="jt-list-heading ps-3">Depends on this job &rarr;</p>
					@if (Model.RequiredBy.Count == 0) {
						<ul class="jt-list jt-list--wide mb-0">
							<li class="jt-muted">None.</li>
						</ul>
					} else {
						<ul class="jt-list jt-list--wide mb-0">
							@foreach (var node in Model.RequiredBy) {
								<li class="d-flex flex-wrap align-items-center gap-3">
									<a class="jt-preserve-whitespace" asp-page="/Jobs/Browse"
									   asp-route-nodeId="@node.Id.Value">@JobNodeDisplay.Title(node, JobNodeDisplay.RowTitleMaxDescriptionLength)</a>
									<span class="d-flex align-items-center gap-2 ms-auto">
										<partial name="_KindIcon" model="@(new KindIconModel {
											                                 Kind = node.Kind, CollapseLabelOnNarrow = true,
										                                 })"/>
										@if (node.ArchivedAt is not null) {
											<span class="jt-muted"> · archived</span>
										}
									</span>
								</li>
							}
						</ul>
					}
				</div>
			</div>
		</div>
	}

	@if (Model.CurrentNode.Node.Kind != NodeKind.Root && Model.AncestorBlockers.Count > 0) {
		<details class="jt-card">
			<summary class="jt-disclosure-summary">Inherited blockers (from ancestor prerequisites)</summary>
			<ul class="jt-list jt-list--wide mb-0">
				@foreach (var blocker in Model.AncestorBlockers) {
					<li>
						<div class="row g-3 align-items-center">
							<div class="col-12 col-md-6 d-flex align-items-center gap-3">
								<span class="status-pill status-pill--icon status-pill-blocked" role="status"><svg class="status-pill-glyph"
								                                                                                   viewBox="0 0 16 16"
								                                                                                   aria-hidden="true"
								                                                                                   focusable="false"><use
											href="#jt-icon-stop"></use></svg><span class="visually-hidden">Blocking</span></span>
								<a class="jt-preserve-whitespace" asp-page="/Jobs/Browse"
								   asp-route-nodeId="@blocker.RequiredJobId">@JobNodeDisplay.Title(blocker.RequiredDescription, blocker.RequiredJobId, JobNodeDisplay.RowTitleMaxDescriptionLength)</a>
							</div>
							<div class="col-12 col-md-6 d-flex align-items-center gap-3">
								<span class="jt-muted">declared on</span>
								<a class="jt-preserve-whitespace" asp-page="/Jobs/Browse"
								   asp-route-nodeId="@blocker.DeclaredOnJobId">@JobNodeDisplay.Title(blocker.DeclaredOnDescription, blocker.DeclaredOnJobId, JobNodeDisplay.RowTitleMaxDescriptionLength)</a>
							</div>
						</div>
					</li>
				}
			</ul>
		</details>
	}
}

<partial name="_BrowseResults" model="Model"/>

@if (Model.CurrentNode is not null && !Model.IsSearch) {
	<aside class="jt-history" id="jt-history" aria-label="Recently visited">
		<div class="d-flex align-items-baseline gap-3 mb-2">
			<p class="jt-history-label">Recently visited</p>
			@if (Model.RecentNodes.Count > 0) {
				<form method="post" asp-page-handler="ClearRecentHistory" class="inline-form">
					@foreach (var field in Model.RowStateFields) {
						<input type="hidden" name="@field.Key" value="@field.Value"/>
					}
					<button type="submit" id="jt-history-clear" class="btn btn-link btn-sm jt-history-clear"
					        aria-label="Clear recently visited">Clear
					</button>
				</form>
			}
		</div>
		<ul id="jt-history-list" class="jt-history-list">
			@if (Model.RecentNodes.Count == 0) {
				<li class="jt-history-empty">None yet.</li>
			} else {
				@foreach (var node in Model.RecentNodes) {
					<li>
						<a asp-page="/Jobs/Browse" asp-route-nodeId="@node.Id.Value"
						   class="jt-preserve-whitespace">@(JobNodeDisplay.Truncate(node.Description, BrowseModel.RecentNodeDescriptionLength)) (ID @node.Id.Value)</a>
					</li>
				}
			}
		</ul>
	</aside>
}
