@page
@using JobTrack.Abstractions
@using NodaTime
@model AwaitingProgressModel
@{
	ViewData["Title"] = "Jobs awaiting progress";
}

<div class="jt-page-head">
	<h1>Jobs awaiting progress</h1>
</div>

<partial name="_ErrorAlert" model="Model.ErrorMessage"/>

<partial name="_SuccessAlert" model="Model.SuccessMessage"/>

@if (Model.SubtreeRoot is not null) {
	<p class="jt-context d-flex flex-wrap align-items-baseline gap-2">
		<span>Scoped to <strong><a class="jt-preserve-whitespace" asp-page="/Jobs/Browse"
		                           asp-route-nodeId="@Model.SubtreeRoot.Node.Id.Value">@JobNodeDisplay.Title(Model.SubtreeRoot.Node)</a></strong></span>
		<a asp-page="/Jobs/AwaitingProgress" asp-route-ownerUserId="@Model.OwnerUserId" asp-route-showWholeTree="true">Show the whole tree</a>
	</p>
}

<form method="get" asp-page="/Jobs/AwaitingProgress" class="jt-form-card jt-filter-form">
	<input type="hidden" asp-for="SubtreeRootId"/>
	<input type="hidden" asp-for="ShowWholeTree"/>
	<div class="row g-3">
		<div class="form-group col-12 col-md-6">
			<label asp-for="OwnerUserId">Owner</label>
			<select asp-for="OwnerUserId" class="form-control" asp-items="Model.OwnerOptions"></select>
		</div>
		<div class="form-group col-12 col-md-6">
			<label asp-for="SearchText"></label>
			<input asp-for="SearchText" class="form-control"/>
		</div>
		<div class="form-group col-12 col-md-6">
			<label asp-for="UnassignedOnly">
				<input asp-for="UnassignedOnly"/>
				Unassigned only (the pickup pool)
			</label>
		</div>
		<div class="form-group col-12 col-md-6">
			<label asp-for="ExcludeBlocked">
				<input asp-for="ExcludeBlocked"/>
				Hide blocked jobs (unsatisfied prerequisites)
			</label>
		</div>
		@* Narrows by achievement, not by who is clocked on: a paused leaf is still in progress, so it
		   stays in. The Owner selector above is the "everyone or a given person" half of this filter. *@
		<div class="form-group col-12 col-md-6">
			<label asp-for="InProgressOnly">
				<input asp-for="InProgressOnly"/>
				In progress only (started, not closed &mdash; includes paused)
			</label>
		</div>
	</div>
	<button type="submit" class="btn btn-primary">Apply</button>
	<a class="btn btn-secondary" asp-page="/Jobs/Browse" asp-route-nodeId="@Model.SubtreeRootId">Browse</a>
</form>

@if (Model.Entries.Count == 0) {
	<p class="jt-empty">No jobs are awaiting progress.</p>
} else {
	<div class="jt-table-block">
		<table class="table">
			<thead>
			<tr>
				@* No achievement column: at one twelfth it was narrower than the word heading it, so the
				   state trails the row's name instead, exactly as it does on Browse's subtree tables.
				   Its share goes to the description, the only column that can always use more.
				   Column allowance mirrors Browse's own child-nodes table (Description/Pri/Due/Active/
				   Cost/Actions) so the same row reads at the same width on either page. *@
				<th class="col-10 col-md-5 col-lg-5 col-xxl-3" aria-label="Description">Desc</th>
				<th class="jt-col-secondary col-xxl-1 d-none d-xxl-table-cell" aria-label="Priority">Pri</th>
				<th class="jt-col-secondary col-lg-1 d-none d-lg-table-cell" aria-label="Deadline">Due</th>
				@* col-lg-2, not the col-lg-1 every other secondary column gets: two or more simultaneous
				   workers' names (the preview list below the count pill) need more than a twelfth of the
				   row at this breakpoint or they wrap to a ladder of one-word lines. Description gives up
				   the column, staying at its "at least 3 of 12" floor rather than the 5 it held before. *@
				<th class="jt-col-active col-md-2 col-lg-2 d-none d-md-table-cell">Active</th>
				<th class="jt-col-cost col-md-3 col-lg-2 text-end d-none d-md-table-cell">Cost</th>
				<th class="col-2 text-end">Actions</th>
			</tr>
			</thead>
			<tbody>
			@foreach (var entry in Model.Entries) {
				var entryActions = Model.WorkRowActionsFor(entry.Id, entry.Achievement);
				<tr>
					<td class="col-10 col-md-5 col-lg-5 col-xxl-3">
						@if (!entry.IsReady) {
							<span class="status-pill status-pill--icon status-pill-blocked"><svg class="status-pill-glyph" viewBox="0 0 16 16"
							                                                                     aria-hidden="true" focusable="false"><use
										href="#jt-icon-stop"></use></svg><span class="visually-hidden">Blocked</span></span>
						}
						<a class="jt-preserve-whitespace" asp-page="/Jobs/Browse"
						   asp-route-nodeId="@entry.Id.Value">@JobNodeDisplay.Title(entry, JobNodeDisplay.RowTitleMaxDescriptionLength)</a>&#x2060;
						@* Trails the name, as on Browse's subtree tables: the word-joiner keeps the marker
						   attached to the title's final word at every width, and no achievement recorded
						   draws nothing rather than a word standing in for the absence. *@
						<partial name="_AchievementIcon"
						         model="@(new AchievementIconModel { Achievement = entry.Achievement, ShowLabel = false })"/>
					</td>
					<td class="jt-col-secondary col-xxl-1 d-none d-xxl-table-cell">
						<partial name="_PriorityLabel" model="@(new PriorityLabelModel { Priority = entry.Priority })"/>
					</td>
					<td class="jt-col-secondary col-lg-1 d-none d-lg-table-cell">@{ var needed = entry.NeededFinish ?? entry.NeededStart; }
						@if (needed is Instant neededInstant) {
							<span
								class="@(InstantDisplay.IsPast(neededInstant, Model.Now) ? "jt-overdue" : null)">@InstantDisplay.FormatCompact(neededInstant, Model.ViewerZone, Model.Now)</span>
						}
					</td>
					<td class="jt-col-active col-md-2 col-lg-2 d-none d-md-table-cell">
						<partial name="_ActiveSincePill"
						         model="@(new ActiveSessionSummaryModel {
							                ActiveSessions = entryActions.ActiveSessions,
							                ViewerId = Model.CurrentActorId ?? new AppUserId(0),
							                DescribeWorker = id => Model.DescribeOwner(id),
							                ViewerZone = Model.ViewerZone,
							                Now = Model.Now,
							                StartClosed = entryActions.IsStartClosed,
							                Paused = entryActions.IsPaused,
						                })"/>
					</td>
					<td class="jt-col-cost col-md-3 col-lg-2 text-end d-none d-md-table-cell">@(entry.Cost.HasValue && entry.AllocatedDuration is not null
							? CostDisplay.FormatCell(entry.Cost.Value, entry.AllocatedDuration)
							: null)</td>
					<td class="col-2">
						<partial name="_WorkRowActions" model="entryActions"/>
					</td>
				</tr>
			}
			</tbody>
		</table>
	</div>

	@if (Model.HasMore) {
		<a class="btn btn-outline-secondary"
		   asp-page="/Jobs/AwaitingProgress"
		   asp-route-OwnerUserId="@Model.OwnerUserId"
		   asp-route-UnassignedOnly="@Model.UnassignedOnly"
		   asp-route-SubtreeRootId="@Model.SubtreeRootId"
		   asp-route-ShowWholeTree="@Model.ShowWholeTree"
		   asp-route-SearchText="@Model.SearchText"
		   asp-route-ExcludeBlocked="@Model.ExcludeBlocked"
		   asp-route-InProgressOnly="@Model.InProgressOnly"
		   asp-route-Offset="@(Model.Offset + AwaitingProgressModel.PageSize)">
			Next page
		</a>
	}
}
