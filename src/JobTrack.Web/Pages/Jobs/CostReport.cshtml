@page
@using System.Globalization
@model CostReportModel
@{
	ViewData["Title"] = "Cost report";
}

<div class="jt-page-head">
	<h1>Cost report</h1>
</div>

<partial name="_ErrorAlert" model="Model.ErrorMessage"/>

<form method="get" asp-page="/Jobs/CostReport" class="jt-form-card">
	<div class="form-group">
		<label asp-for="NodeId"></label>
		<input asp-for="NodeId" class="form-control"/>
	</div>
	<div class="form-group">
		<label asp-for="AsOf">As of (leave blank for now)</label>
		<input asp-for="AsOf" type="datetime-local" step="60" class="form-control"/>
	</div>
	<button type="submit" class="btn btn-primary">View</button>
</form>

@if (Model.Node is not null) {
	<h2><a class="jt-preserve-whitespace" asp-page="/Jobs/Browse" asp-route-nodeId="@Model.NodeId">@JobNodeDisplay.Title(Model.Node.Node)</a></h2>

	<p><a asp-page="/Jobs/Browse" asp-route-nodeId="@Model.NodeId">&larr; Back to Browse</a></p>

	@if (Model.Readiness is not null) {
		<partial name="_Readiness" model="Model.Readiness"/>
	}

	var costDetails = Model.CostDetails;
	@if (costDetails is not null) {
		<div class="row row-cols-1 row-cols-sm-3 g-3 mb-4">
			<div class="col jt-metric">
				<span class="jt-metric-label">Exact cost</span>
				<span class="jt-metric-value jt-amount">@MoneyDisplay.Format(costDetails.ExactCost)</span>
			</div>
			<div class="col jt-metric">
				<span class="jt-metric-label">Displayed cost</span>
				<span class="jt-metric-value jt-amount">@MoneyDisplay.Format(costDetails.DisplayedCost)</span>
				<span class="jt-metric-sub">Rounded to pennies</span>
			</div>
			<div class="col jt-metric">
				<span class="jt-metric-label">Allocated time</span>
				<span class="jt-metric-value">@costDetails.AllocatedDuration</span>
				<span class="jt-metric-sub">Concurrency-adjusted</span>
			</div>
		</div>

		<h3>Rate provenance</h3>
		@if (costDetails.Trace.Count == 0) {
			<p class="jt-empty">No costed segments.</p>
		} else {
			<div class="jt-table-block">
				<table class="table">
					<thead>
					@* Two full timestamps plus three costing columns never fit a phone. What a segment cost
					   and the rate it was costed at survive at every width, anchored by the segment's own
					   start; the end returns at md (it is largely the next row's start until then) and the
					   rate's provenance at lg, where the derivation is worth its column. *@
					<tr>
						<th class="col-5 col-md-4 col-lg-3">Segment start</th>
						<th class="col-md-3 d-none d-md-table-cell">Segment end</th>
						<th class="col-3 col-md-2">Rate per hour</th>
						<th class="col-lg-2 d-none d-lg-table-cell">Rate source</th>
						<th class="col-4 col-md-3 col-lg-2">Contribution</th>
					</tr>
					</thead>
					<tbody>
					@foreach (var entry in costDetails.Trace) {
						<tr>
							<td class="col-5 col-md-4 col-lg-3">@InstantDisplay.Format(entry.Segment.Start, Model.ViewerZone)</td>
							<td class="col-md-3 d-none d-md-table-cell">@InstantDisplay.Format(entry.Segment.End, Model.ViewerZone)</td>
							<td class="jt-amount col-3 col-md-2">@entry.ResolvedRate.Rate.AmountPerHour.ToString("0.00", CultureInfo.InvariantCulture)</td>
							<td class="col-lg-2 d-none d-lg-table-cell">@entry.ResolvedRate.Source</td>
							<td class="jt-amount col-4 col-md-3 col-lg-2">@MoneyDisplay.Format(entry.UnroundedContribution)</td>
						</tr>
					}
					</tbody>
				</table>
			</div>
		}
	}
}
