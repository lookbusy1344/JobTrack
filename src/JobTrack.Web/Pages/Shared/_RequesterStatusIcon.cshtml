@using JobTrack.Abstractions
@model RequesterStatusIconModel
@{
	var glyph = Model.Status switch {
		RequesterStatus.Submitted or RequesterStatus.Accepted or RequesterStatus.Waiting =>
			("jt-icon-achievement-waiting", "waiting"),
		RequesterStatus.InProgress => ("jt-icon-achievement-in-progress", "in-progress"),
		RequesterStatus.Completed => ("jt-icon-achievement-success", "success"),
		RequesterStatus.Cancelled => ("jt-icon-achievement-closed", "closed"),
		RequesterStatus.None => default((string IconId, string Modifier)?),
		_ => throw new ArgumentOutOfRangeException(nameof(Model.Status), Model.Status, null),
	};
}
@if (glyph is var (iconId, modifier)) {
	var label = EnumDisplay.Label(Model.Status);
	<span class="jt-achievement-icon jt-achievement-icon--@modifier">
		<svg class="jt-achievement-icon-glyph" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
			<use href="#@iconId"></use>
		</svg>
		@if (Model.ShowLabel) {
			<span class="jt-achievement-icon-label">@label</span>
		} else {
			<span class="visually-hidden">@label</span>
		}
	</span>
}
