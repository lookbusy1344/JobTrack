@model ActiveSessionSummaryModel
@* Renders nothing when there is no running session unless the caller explicitly identifies an
   Unstarted or Unack state.

   Zero/one/several are three distinct presentations (plan §2.4), never a collapsed "pick one":
   - zero: nothing here (the outer @if below), unless the leaf has a named operational state. A
     terminal leaf preserves Success, Cancelled, or Unsuccessful rather than collapsing to Closed;
     a successful branch uses its computed Success, while an unfinished branch remains blank. An
     archived non-terminal leaf retains Closed. The verbose "reopen it before starting another
     session" sentence this replaces never belonged in the Actions cell.
     Zero sessions on an *In Progress* leaf is the third case: paused, someone stopped part-way, and
     it gets its own pill rather than reading identically to a leaf nobody has ever started. Browse
     subtree rows name that latter state Unstarted, with Unack taking precedence for an
     unacknowledged request.
   - one: the familiar compact stopwatch pill, icon plus the bare timestamp (data, not a word) --
     worker named only when it is not the viewer.
   - two or more: a prominent active-count pill, followed by the stable preview (You first, then every
     other worker by start order), capped at ActiveSessionSummaryModel.PreviewLimit only in the dense
     per-row form -- the full collection is always still reachable via Sessions, never truly lost.

   A table cell (Compact) drops a *word* competing for room against the worker names that follow it
   on the same line ("N active" wrapped mid-word beside its own name preview) down to the glyph plus
   whatever data it carries -- a bare count. Closed and Paused have no such neighbour, so they keep
   their full word at every width, just sized down (status-pill--compact) in a table cell; a record
   display (Work's own status field, Browse's toolbar summary) never compacts at all. *@
@if (Model.Count == 1) {
	var entry = Model.PreviewEntries[0];
	var since = InstantDisplay.FormatCompact(entry.Session.StartedAt, Model.ViewerZone, Model.Now);
	var workedBy = entry.IsViewer ? string.Empty : $" · worked by {entry.DisplayName}";
	@if (Model.Compact) {
		<span class="status-pill status-pill-active status-pill--compact" title="Active since @since@workedBy">
			<svg class="status-pill-glyph" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
				<use href="#jt-icon-active"></use>
			</svg>
			<span class="visually-hidden">Active since</span>
			@since
			@if (!string.IsNullOrEmpty(workedBy)) {
				<span class="visually-hidden">@workedBy</span>
			}
		</span>
	} else {
		<span class="status-pill status-pill-active">
			<svg class="status-pill-glyph" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
				<use href="#jt-icon-active"></use>
			</svg>
			Active since @since@workedBy
		</span>
	}
} else if (Model.Count > 1) {
	<span class="d-inline-flex flex-wrap align-items-center gap-1">
		@if (Model.Compact) {
			<span class="status-pill status-pill-active status-pill--compact" title="@Model.Count active">
				<svg class="status-pill-glyph" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
					<use href="#jt-icon-active"></use>
				</svg>
				<span class="visually-hidden">Active count</span>
				@Model.Count
			</span>
		} else {
			<span class="status-pill status-pill-active">
				<svg class="status-pill-glyph" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
					<use href="#jt-icon-active"></use>
				</svg>
				@Model.Count active
			</span>
		}
		@* A size down (.jt-text-sm, the app's one smaller step): the names support the count pill beside
		   them rather than competing with it, and the run grows with every extra worker. *@
		<span class="jt-muted jt-text-sm">
			<span class="visually-hidden">Active workers:</span>
			@string.Join(", ", Model.PreviewEntries.Select(e => e.DisplayName))@(Model.HiddenCount > 0 ? $" +{Model.HiddenCount} more" : "")
		</span>
	</span>
} else if (Model.IdleStatus is ActiveIdleStatus idleStatus) {
	var (modifier, label, pillLabel) = idleStatus switch {
		                                   ActiveIdleStatus.Closed => ("status-pill-closed", "Closed", "Closed"),
		                                   ActiveIdleStatus.Paused => ("status-pill-paused", "Paused", "Paused"),
		                                   ActiveIdleStatus.Unacknowledged => ("status-pill-unack", "Unack", "Unack"),
		                                   ActiveIdleStatus.Unstarted => ("status-pill-inactive", "Unstarted", "Unstrt"),
		                                   ActiveIdleStatus.Waiting => ("status-pill-waiting", "Waiting", "Wait"),
		                                   ActiveIdleStatus.Success => ("status-pill-success", "Success", "Succ"),
		                                   ActiveIdleStatus.Cancelled => ("status-pill-cancelled", "Cancelled", "Cancel"),
		                                   ActiveIdleStatus.Unsuccessful => ("status-pill-unsuccessful", "Unsuccessful", "Unsucc"),
		                                   _ => throw new ArgumentOutOfRangeException(nameof(Model.IdleStatus), Model.IdleStatus, null),
	                                   };
	var title = pillLabel == label ? null : label;
	<span class="status-pill @modifier@(Model.Compact ? " status-pill--compact" : string.Empty)" title="@title">@pillLabel</span>
}
