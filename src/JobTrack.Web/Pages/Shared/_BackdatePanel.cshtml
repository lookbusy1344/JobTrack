@model BackdateDisclosureModel
@* Every backdate trigger's revealed form, wherever it sits (toolbar, table row, session row) --
   site.js moves this to the end of <body> on first open and positions it with `position: fixed`
   from the trigger's own rect (`.jt-backdate-panel--floating`), so it floats over the page instead
   of pushing whatever follows it down, and no ancestor's scroll clipping (e.g. `.jt-table-scroll`'s
   horizontal scroll) can cut it off. `aria-controls`/`aria-expanded` on the trigger associate the
   two by id, which keeps working regardless of where this ends up in the DOM. *@
<div id="@Model.RowId" class="jt-backdate-panel jt-backdate-panel--floating" hidden>
	<partial name="_BackdateForm" model="Model"/>
</div>
