<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <!-- Test method names use underscores by convention (Method_does_thing); CA1707 covers
             that. IDE0058 is suppressed only here: AwesomeAssertions .Should()... chains are
             expression statements whose value is intentionally discarded. Source projects do not
             suppress IDE0058 — they use explicit discards instead. -->
        <NoWarn>$(NoWarn);CA1707;IDE0058</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AwesomeAssertions"/>
        <PackageReference Include="coverlet.collector">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="xunit"/>
        <PackageReference Include="xunit.runner.visualstudio">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <!-- Architecture guards inspect Razor through the compiler belonging to the SDK selected by
             global.json. Referencing the SDK copy keeps parsing exactly aligned with the build and
             avoids a second, independently versioned Razor parser package. -->
        <Reference Include="Microsoft.CodeAnalysis"
                   HintPath="$(MSBuildToolsPath)/Roslyn/bincore/Microsoft.CodeAnalysis.dll"
                   Private="true"/>
        <Reference Include="Microsoft.CodeAnalysis.CSharp"
                   HintPath="$(MSBuildToolsPath)/Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll"
                   Private="true"/>
        <Reference Include="Microsoft.CodeAnalysis.Razor.Compiler"
                   HintPath="$(MSBuildSDKsPath)/Microsoft.NET.Sdk.Razor/source-generators/Microsoft.CodeAnalysis.Razor.Compiler.dll"
                   Private="true"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\JobTrack.Abstractions\JobTrack.Abstractions.csproj"/>
        <ProjectReference Include="..\..\src\JobTrack.AdminCli\JobTrack.AdminCli.csproj"/>
        <ProjectReference Include="..\..\src\JobTrack.Domain\JobTrack.Domain.csproj"/>
        <ProjectReference Include="..\..\src\JobTrack.Database\JobTrack.Database.csproj"/>
        <ProjectReference Include="..\..\src\JobTrack.Application\JobTrack.Application.csproj"/>
        <ProjectReference Include="..\..\src\JobTrack.Persistence.PostgreSql\JobTrack.Persistence.PostgreSql.csproj"/>
        <ProjectReference Include="..\..\src\JobTrack.Persistence.Shared\JobTrack.Persistence.Shared.csproj"/>
        <ProjectReference Include="..\..\src\JobTrack.Persistence.Sqlite\JobTrack.Persistence.Sqlite.csproj"/>
        <ProjectReference Include="..\..\src\JobTrack.Identity\JobTrack.Identity.csproj"/>
        <ProjectReference Include="..\..\src\JobTrack.Web\JobTrack.Web.csproj"/>
        <ProjectReference Include="..\JobTrack.TestSupport\JobTrack.TestSupport.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

</Project>
